NODE_ENV=development
PORT=3000

# Postgres (DB_HOST=db inside docker compose, localhost when running the app on the host)
DB_HOST=db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# true for hosted Postgres with a publicly trusted certificate (e.g. Neon)
DB_SSL=false
# PEM of the server's CA for hosts with a private CA (Supabase: Database settings -> SSL -> download certificate).
# Turns SSL on by itself.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Auto-create tables on startup. Unset: on outside production. Set true in production while there are no migrations.
# DB_SYNCHRONIZE=true

# Default GREEN-API host, used when login does not pass apiUrl (copy it from the GREEN-API console)
GREEN_API_URL=https://api.green-api.com
# Frontend origin allowed by CORS (with credentials)
FRONTEND_ORIGIN=http://localhost:5173
# Session cookie lifetime in days
SESSION_TTL_DAYS=7
